    "typescript": "~6.0.2",
    "typescript-eslint": "^8.46.3",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "@eslint/js": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^26.0.0",
